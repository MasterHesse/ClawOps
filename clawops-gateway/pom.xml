<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.clawops</groupId>
    <artifactId>clawops-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>clawops-gateway</artifactId>
  <name>ClawOps :: Gateway</name>
  <description>接入层：WS+HTTP、鉴权、通道适配器（飞书/钉钉）、Webhook</description>

  <properties>
    <jacoco.min.line-ratio>0.40</jacoco.min.line-ratio>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>com.clawops</groupId>
      <artifactId>clawops-harness</artifactId>
    </dependency>
    <dependency>
      <groupId>com.clawops</groupId>
      <artifactId>clawops-connector</artifactId>
    </dependency>
    <!-- W2：任务域（TaskStore/Checkpoint/审批）与 RAG 域（kb）模块 -->
    <dependency>
      <groupId>com.clawops</groupId>
      <artifactId>clawops-orchestrator</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.clawops</groupId>
      <artifactId>clawops-rag</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 持久层：JPA + Flyway（迁移脚本分布在 orchestrator/rag 模块 jar 内） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4 模块化：Flyway 自动配置位于专用 starter（含 spring-boot-flyway 模块） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- IT（OpenApiContractIT 等需完整上下文 + 数据源）：Testcontainers PG -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
