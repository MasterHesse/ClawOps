# ===== ClawOps 环境变量样例 =====
# 复制为 .env 并填入真实值；.env 永不入库（见 .gitignore 与 TASK_BOOK §5.5）

# ---- LLM API（仅 eval / 手动验证使用；单测集测一律 FakeChatModel）----
CLAWOPS_LLM_API_KEY=
CLAWOPS_LLM_BASE_URL=https://api.openai.com/v1
CLAWOPS_LLM_CHAT_MODEL=gpt-4o-mini
CLAWOPS_LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---- PostgreSQL 17 + pgvector ----
POSTGRES_USER=clawops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clawops
POSTGRES_PORT=5432

# ---- Redis 7 ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Prometheus ----
PROMETHEUS_PORT=9090

# ---- 应用 ----
CLAWOPS_PORT=8080
